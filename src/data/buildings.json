[
  { "id": "road", "name": "路", "description": "最基础的道路。建筑必须贴着路或桥，完工后才会生效。可按住左键拖出一整条路。", "category": "infrastructure", "cost": 1, "woodCost": 0, "labor": 0, "footprint": { "w": 1, "h": 1 }, "buildSeasons": 1, "maxLevel": 1, "placeable": true },
