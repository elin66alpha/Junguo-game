  { "id": "hut", "name": "小屋", "description": "最初级的住房。接上道路并满足水、粮食、布、教化等条件后，会自动一路升级到瓦房、院宅、深宅、府第，乃至华堂、甲第。", "category": "housing", "cost": 10, "woodCost": 4, "labor": 0, "footprint": { "w": 1, "h": 1 }, "buildSeasons": 1, "maxLevel": 1, "placeable": true },
  { "id": "mansion", "name": "豪宅", "description": "2×2 的高等民居。需要道路和完整服务才能住满；可手动升到 3 级，每次升级都会扩大人口容量，并消耗木材与布。", "category": "housing", "cost": 160, "woodCost": 24, "clothCost": 12, "labor": 0, "footprint": { "w": 2, "h": 2 }, "buildSeasons": 3, "maxLevel": 3, "initialHousingTier": "mansion1", "placeable": true },
  { "id": "tileHouse", "name": "瓦房", "description": "住房升级层级，不直接建造。", "category": "housing", "cost": 30, "woodCost": 0, "labor": 0, "footprint": { "w": 2, "h": 2 }, "buildSeasons": 2, "maxLevel": 1, "placeable": false },
  { "id": "courtyardHouse", "name": "院宅", "description": "住房升级层级，不直接建造。", "category": "housing", "cost": 80, "woodCost": 0, "labor": 0, "footprint": { "w": 3, "h": 3 }, "buildSeasons": 3, "maxLevel": 1, "placeable": false },
  { "id": "well", "name": "水井", "description": "为范围内住房提供水源服务。水不作为库存资源；住房在水井范围内即可满足用水条件。水井有小概率枯竭，升级后服务半径扩大且更稳定。", "category": "service", "cost": 20, "woodCost": 3, "labor": 1, "footprint": { "w": 1, "h": 1 }, "buildSeasons": 1, "radius": 6, "maxLevel": 5, "placeable": true },
  { "id": "farm", "name": "农田", "description": "生产粮食。春耕、夏长、秋收、冬闲的产量不同；丘陵和河流不能建农田。沃土上产量更高。升级后产量提高。未接道路时停产。", "category": "production", "cost": 25, "woodCost": 4, "labor": 4, "footprint": { "w": 3, "h": 3 }, "buildSeasons": 3, "maxLevel": 5, "placeable": true },
  { "id": "workshop", "name": "作坊", "description": "生产布。布主要供瓦房及以上住房消耗。升级后产量提高。未接道路时停产。", "category": "production", "cost": 40, "woodCost": 8, "labor": 3, "footprint": { "w": 2, "h": 2 }, "buildSeasons": 2, "maxLevel": 5, "placeable": true },
  { "id": "lumberCamp", "name": "伐木场", "description": "每月产出木材。3 格内有林地时产量翻倍，伐木场会逐步砍伐周围林地。木材用于建造和升级几乎所有建筑。", "category": "production", "cost": 30, "woodCost": 0, "labor": 3, "footprint": { "w": 2, "h": 2 }, "buildSeasons": 2, "radius": 3, "maxLevel": 5, "placeable": true },
  { "id": "granary", "name": "粮仓", "description": "提供粮食可达服务，并扩大全县粮食库存上限。住房在粮仓范围内，才会继续成长和升级。升级后服务半径和仓容都会提高。", "category": "service", "cost": 60, "woodCost": 6, "labor": 2, "footprint": { "w": 2, "h": 2 }, "buildSeasons": 2, "radius": 8, "maxLevel": 5, "placeable": true },
  { "id": "warehouse", "name": "仓库", "description": "扩大全县木材和布的库存上限。每级增加 200 木材上限和 500 布上限。未接道路时不生效。", "category": "service", "cost": 55, "woodCost": 8, "labor": 2, "footprint": { "w": 2, "h": 2 }, "buildSeasons": 2, "maxLevel": 5, "placeable": true },
  { "id": "market", "name": "市场", "description": "配送粮食和布，并改善周边秩序。市场覆盖范围内的住房按等级缴纳商税：等级越高的住房、等级越高的市场，月入越多。升级后服务半径扩大。未接道路时不提供服务。", "category": "service", "cost": 40, "woodCost": 6, "labor": 2, "footprint": { "w": 2, "h": 2 }, "buildSeasons": 2, "radius": 8, "maxLevel": 5, "placeable": true },
  { "id": "tradeStation", "name": "贸易站", "description": "3×3 的商旅转运建筑。解锁粮食、木材和布的贸易路线；建成并接通道路后，可在资源明细面板买卖资源。", "category": "service", "cost": 80, "woodCost": 10, "labor": 2, "footprint": { "w": 3, "h": 3 }, "buildSeasons": 2, "maxLevel": 5, "placeable": true },
  { "id": "riverDock", "name": "河港", "description": "必须建在河边。接通道路后开通漕运网络，每月轮流运入漕粮、漕木或漕布，价格低于贸易站，但有沉船和盗船风险。", "category": "service", "cost": 95, "woodCost": 16, "labor": 3, "footprint": { "w": 2, "h": 2 }, "buildSeasons": 3, "maxLevel": 5, "requires": "riverAdjacent", "placeable": true },
  { "id": "stage", "name": "戏台", "description": "1×2 的小型服务建筑。接通道路后放大四时节庆的民心和声望效果。", "category": "service", "cost": 45, "woodCost": 10, "labor": 1, "footprint": { "w": 1, "h": 2 }, "buildSeasons": 2, "radius": 5, "maxLevel": 5, "placeable": true },
  { "id": "magistrateOffice", "name": "衙门", "description": "郡县政务核心。接入道路后提高治安与声望，后续版本会承载官员和政务。", "category": "civic", "cost": 100, "woodCost": 12, "labor": 2, "footprint": { "w": 3, "h": 3 }, "buildSeasons": 3, "maxLevel": 5, "placeable": true },
  { "id": "school", "name": "学宫", "description": "地方教化与士人往来之所。接入道路后提高声望，并解锁院宅以上住房。升级后声望更高。", "category": "civic", "cost": 70, "woodCost": 10, "labor": 2, "footprint": { "w": 2, "h": 2 }, "buildSeasons": 2, "maxLevel": 5, "placeable": true },
  { "id": "shrine", "name": "祭坛", "description": "地方祭祀场所，改善附近住房民心。升级后服务半径扩大。未接道路时无效。", "category": "civic", "cost": 50, "woodCost": 8, "labor": 1, "footprint": { "w": 2, "h": 2 }, "buildSeasons": 2, "radius": 6, "maxLevel": 5, "placeable": true },
  { "id": "lingqu", "name": "灵渠", "description": "奇观，农之大工。一行 5 格，两端必须是非丘陵陆地，中间 3 格必须是河流。完工后全图农田 +20% 产出，免疫水灾事件，并降低邻郡漕粮费用。", "category": "wonder", "cost": 420, "woodCost": 90, "labor": 8, "footprint": { "w": 5, "h": 1 }, "buildSeasons": 8, "maxLevel": 1, "requires": "riverSegment5", "placeable": true },
  { "id": "mountainShrine", "name": "名山祠", "description": "奇观，礼之所归。必须建在连续 3 格以上丘陵簇上。完工后教化全图覆盖，声望逐月积累，并放大节庆效果。", "category": "wonder", "cost": 360, "woodCost": 70, "labor": 6, "footprint": { "w": 2, "h": 2 }, "buildSeasons": 7, "maxLevel": 1, "requires": "hillCluster3", "placeable": true },
  { "id": "grandMarketTower", "name": "大市楼", "description": "奇观，商之会要。必须建在 4×4 连续平原且贴沃土。完工后市场商税 +40%，贸易站价格波动减半，邻郡态度逐月改善。", "category": "wonder", "cost": 390, "woodCost": 80, "labor": 7, "footprint": { "w": 4, "h": 4 }, "buildSeasons": 7, "maxLevel": 1, "requires": "plain4NearFertile", "placeable": true },
